# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_URL="https://nova-indukt.de"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-with-node-crypto-randombytes-base64-32"

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="support@nova-indukt.de"
FROM_EMAIL="support@nova-indukt.de"
FROM_NAME="NOVA INDUKT"
ADMIN_EMAIL="support@nova-indukt.de"

# ── Contact Emails (used in footer, impressum, etc.) ────────────────────────
NEXT_PUBLIC_EMAIL_INFO="info@nova-indukt.de"
NEXT_PUBLIC_EMAIL_SUPPORT="support@nova-indukt.de"
NEXT_PUBLIC_EMAIL_DATENSCHUTZ="datenschutz@nova-indukt.de"
NEXT_PUBLIC_EMAIL_WIDERRUF="widerruf@nova-indukt.de"
NEXT_PUBLIC_EMAIL_KONTAKT="kontakt@nova-indukt.de"
NEXT_PUBLIC_EMAIL_NEWSLETTER="newsletter@nova-indukt.de"
NEXT_PUBLIC_EMAIL_NOREPLY="noreply@nova-indukt.de"
NEXT_PUBLIC_EMAIL_ADMIN="admin@nova-indukt.de"

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="..."

# ── Upstash Redis (rate limiting — falls back to in-memory if not set) ──────
UPSTASH_REDIS_REST_URL="..."
UPSTASH_REDIS_REST_TOKEN="..."

# ── Bank Details (for invoice/payment emails) ──────────────────────────────
NEXT_PUBLIC_BANK_HOLDER="NOVA INDUKT GmbH"
NEXT_PUBLIC_BANK_IBAN="DE00 0000 0000 0000 0000 00"
NEXT_PUBLIC_BANK_BIC="XXXXXXXXXXXXXXX"
NEXT_PUBLIC_BANK_NAME="Bank nicht konfiguriert"

# ── Cron / Background Jobs ──────────────────────────────────────────────────
CRON_SECRET="generate-a-strong-random-secret"

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://nova-indukt.de"

# ── Analytics (Google Analytics 4) ──────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── reCAPTCHA v3 (anti-spam) ────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY="6Lc..."
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lc..."

# ── Company Info ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_COMPANY_NAME="NOVA INDUKT GmbH"
NEXT_PUBLIC_COMPANY_ADDRESS_STREET="Berliner Straße 42"
NEXT_PUBLIC_COMPANY_ADDRESS_ZIP="10115"
NEXT_PUBLIC_COMPANY_ADDRESS_CITY="Berlin"
NEXT_PUBLIC_COMPANY_ADDRESS_COUNTRY="DE"

# ── Phone & WhatsApp ────────────────────────────────────────────────────────
# Replace XXXXXXXX with your actual number (e.g. 12345678)
NEXT_PUBLIC_PHONE="+49 30 XXXXXXXX"
NEXT_PUBLIC_PHONE_RAW="4930XXXXXXXX"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/4930XXXXXXXX"

# ── Website URL ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEBSITE_URL="https://nova-indukt.de"

# ── Social Media ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOCIAL_FACEBOOK="https://facebook.com/novaindukt"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/novaindukt"

# ── Google Site Verification (optional) ────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="..."
